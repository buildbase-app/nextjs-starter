# ============================
# BuildBase SaaS Configuration
# ============================

# BuildBase API Server URL
NEXT_PUBLIC_BUILDBASE_SERVER_URL=https://api.buildbase.app

# Your BuildBase Organization ID
NEXT_PUBLIC_BUILDBASE_ORG_ID=your-org-id

# OAuth Client ID from BuildBase
NEXT_PUBLIC_BUILDBASE_CLIENT_ID=your-client-id

# OAuth Redirect URL (must match your BuildBase app configuration)
NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=http://localhost:3000

# ============================
# Server-side Secrets
# (DO NOT expose these publicly)
# ============================

# OAuth Client Secret from BuildBase
BUILDBASE_CLIENT_SECRET=your-client-secret

# System secret for JWT token signing (generate a secure random string)
SYSTEM_SECRET=your-system-secret

# ============================
# SEO & Sitemap Configuration
# ============================

# Site URL for sitemap generation (without trailing slash)
# Used by next-sitemap to generate sitemaps with correct URLs
SITE_URL=https://yourdomain.com
