# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# AI IDE rule files (contain project-specific dev context)
.cursorrules
.windsurfrules
CLAUDE.md
AGENTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# contentlayer
.contentlayer

# pagefind (generated at build time)
public/pagefind
.yalc/@buildbase/sdk/*

# next-sitemap output (postbuild)
/public/sitemap*.xml
/public/robots.txt

# content pulled at build time (npm run content:pull)
.buildbase

# cloudflare (OpenNext / wrangler)
/.open-next
/.wrangler
.dev.vars*
!.dev.vars.example
cloudflare-env.d.ts

# Signed-in end-to-end tests
e2e/.auth/
playwright-report/
playwright-report-live/
test-results/

# Lighthouse CI reports (npm run score)
/.lighthouseci/
