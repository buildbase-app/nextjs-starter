generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id
  email         String  @unique
  name          String?
  image         String?
  role          String  @default("user")
  emailVerified Boolean @default(false)
  timezone      String?
  language      String?
  country       String?
  currency      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserWorkspace {
  userId      String
  workspaceId String
  userRole    String @default("member")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // create, update, delete, upsert
  model       String   // User, Workspace, UserWorkspace
  recordId    String
  userId      String?
  workspaceId String?
  ipAddress   String?
  userAgent   String?
  source      String?  // api, event, system
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([model, recordId])
  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([createdAt])
}
