generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id
  email         String  @unique
  name          String?
  image         String?
  role          String  @default("user")
  emailVerified Boolean @default(false)
  timezone      String?
  language      String?
  country       String?
  currency      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserWorkspace {
  userId      String
  workspaceId String
  userRole    String @default("member")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // create, update, delete, upsert
  model       String   // User, Workspace, UserWorkspace
  recordId    String
  userId      String?
  workspaceId String?
  ipAddress   String?
  userAgent   String?
  source      String?  // api, event, system
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([model, recordId])
  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([createdAt])
}

/// The demo's own product data — documents owned by a BuildBase workspace.
/// Creating one records usage against the `documents` quota and consumes a
/// credit, so billing, quotas and feature flags have something real to gate.
model Document {
  id            String   @id @default(cuid())
  workspaceId   String
  title         String
  content       String
  /// draft | in_review | published | archived
  status        String   @default("draft")
  tags          String[] @default([])
  createdById   String
  createdByName String?
  updatedById   String?
  /// true for rows inserted by the "Load sample data" action
  isSample      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
}

/// Server-to-server webhooks delivered by BuildBase (84 event types), verified
/// with `parseWebhookEvent` and kept so the Events page can show them.
model WebhookEvent {
  id          String   @id @default(cuid())
  event       String
  /// Platform timestamp (ms since epoch) the signature was computed over.
  timestamp   BigInt
  workspaceId String?
  userId      String?
  payload     Json
  receivedAt  DateTime @default(now())

  @@index([event])
  @@index([workspaceId])
  @@index([receivedAt])
}

/// Client-side SDK lifecycle events (`user:*`, `workspace:*`) forwarded by the
/// browser to /api/events so they survive a page reload.
model AppEvent {
  id          String   @id @default(cuid())
  eventType   String
  userId      String?
  workspaceId String?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([eventType])
}
