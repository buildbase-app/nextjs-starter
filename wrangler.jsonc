// Cloudflare Workers config. Used only when deploying to Cloudflare
// (`npm run cf:deploy` or Workers Builds); Vercel and Docker ignore it.
// See README → Deployment → Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker's name in your Cloudflare account. If you change it, change
  // WORKER_SELF_REFERENCE's "service" below to match.
  "name": "nextjs-starter",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    // Lets the Worker call itself for on-demand revalidation.
    { "binding": "WORKER_SELF_REFERENCE", "service": "nextjs-starter" },
  ],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // Optional, recommended for Postgres: Hyperdrive pools database connections
  // at Cloudflare's edge. Create one with
  //   npx wrangler hyperdrive create nextjs-starter-db --connection-string="postgres://..."
  // then uncomment and paste its id. Without it the app connects with
  // DATABASE_URL directly (src/lib/db.ts).
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<your-hyperdrive-id>" }],

  // Secrets (SYSTEM_SECRET, BUILDBASE_CLIENT_SECRET, DATABASE_URL, ...) are not
  // kept here. Set them with `npx wrangler secret put NAME` or in the dashboard
  // (Worker → Settings → Variables and Secrets), and put .env.example's
  // NEXT_PUBLIC_* values in Workers Builds' build variables too.
}
